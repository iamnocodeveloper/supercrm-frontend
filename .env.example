# Copiá este archivo a `.env` y completá los valores.
# NUNCA commitear `.env` (ya está en .gitignore).

# --- Supabase (frontend) ---
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=TU_PUBLISHABLE_KEY
VITE_SUPABASE_PROJECT_ID=TU_PROJECT_REF

# --- IMPORTANTE ---
# La service_role key y las claves de WAHA son SECRETAS y viven SOLO en el
# servidor (Supabase Secrets), nunca en el frontend:
#
#   supabase secrets set WAHA_BASE_URL=https://tu-servidor-waha
#   supabase secrets set WAHA_API_KEY=tu-waha-api-key
#   supabase secrets set WAHA_WEBHOOK_SECRET=...        # opcional (T5)
#   supabase secrets set GOOGLE_GEMINI_API_KEY=...
#
# No agregues VITE_SUPABASE_SERVICE_ROLE_KEY ni VITE_WAHA_API_KEY: no se usan
# en el frontend y exponerlas es un riesgo de seguridad.
